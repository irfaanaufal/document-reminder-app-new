# ============================================================
# CRON CONFIG — reminder-app Scheduler (aaPanel)
# Jalankan di server sebagai root
# ============================================================

set -euo pipefail

APP_DIR=/www/wwwroot/sindangasih-makmur.com/reminder-app
PHP83=/www/server/php/83/bin/php

echo "Setting up cron job for reminder-app..."

# Ambil crontab lama, buang baris reminder-app lama, tambah baris baru
CRON_TMP=$(mktemp)
crontab -l 2>/dev/null | grep -v "reminder-app" > "$CRON_TMP" || true
echo "* * * * * cd $APP_DIR && $PHP83 artisan schedule:run >> /dev/null 2>&1" >> "$CRON_TMP"
crontab "$CRON_TMP"
rm -f "$CRON_TMP"

echo "Cron job added successfully."
echo ""
echo "Current crontab:"
crontab -l
